{
  "uid": "03-fabric",
  "title": "03 · Network fabric — links, errors, congestion",
  "description": "Which cable is sick, and which GPU and tenant sit behind it?",
  "tags": [
    "neocloud"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ports down",
      "description": "Fabric ports reported down. Ports of unpowered servers go down too.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "count(fabric_port_state == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Flapping links (5m)",
      "description": "Links that went down and up in the last 5 minutes. Each flap resets the collectives running over it.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "count(increase(fabric_port_link_downed_total[5m]) > 0) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Links below rated speed",
      "description": "Links that renegotiated below 400 Gb/s. The slowest link sets the pace of the whole training job.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "count((fabric_port_speed_gbps > 0) < 400) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Weakest optical rx power",
      "description": "Lowest received optical power on any link. Falling rx power is the earliest sign of a dirty or failing optic.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "min(fabric_port_rx_power_dbm > -30)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "mappings": [],
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -6
              },
              {
                "color": "green",
                "value": -4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Top symbol error rate (cable / optic health)",
      "description": "Physical-layer errors per second on the five worst ports. Errors rise before a link starts to flap.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "topk_max(5, rate(fabric_port_symbol_errors_total[1m]))",
          "legendFormat": "{{switch}}:{{port}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top congestion (xmit wait rate)",
      "description": "Time ports wait to transmit because of back-pressure: congestion, not cable errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "topk_max(5, rate(fabric_port_xmit_wait_total[1m]))",
          "legendFormat": "{{switch}}:{{port}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Problem links → GPU → tenant (cable to customer in one join)",
      "description": "Every unhealthy link joined through the cabling table to the GPU at its other end and the tenant that owns it.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "(((rate(fabric_port_symbol_errors_total[1m]) > 0) or ((fabric_port_speed_gbps > 0) < 400)) * on(switch, port) group_left(Hostname, gpu, rack) fabric_link_info) * on(Hostname, gpu) group_left(tenant) gpu_tenant_info",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "alertstate": true
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tenant all-reduce time",
      "description": "Time each job spends in the gradient all-reduce. One bad link slows the whole job.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "tenant_job_allreduce_seconds",
          "legendFormat": "{{tenant}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Weakest optics (rx power)",
      "description": "The five links with the lowest received optical power over the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "bottomk_min(5, fabric_port_rx_power_dbm > -30)",
          "legendFormat": "{{switch}}:{{port}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "neocloud"
      ],
      "asDropdown": false,
      "title": "Layers",
      "keepTime": true,
      "includeVars": false
    }
  ]
}